# Copia este archivo a .env.local y completa los valores reales.
# .env.local nunca se sube a git (ver .gitignore).

# --- Clerk (autenticacion) ---
# https://dashboard.clerk.com -> API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Supabase (base de datos) ---
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Clave con privilegios de administrador. NUNCA exponer al cliente ni prefijar con NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Stripe (suscripciones Free/Pro) ---
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# https://dashboard.stripe.com/webhooks (firma del endpoint de webhook)
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# ID del Price del plan Rigger Master (mensual) creado en el dashboard de Stripe
STRIPE_PRO_PRICE_ID=price_xxxxxxxxxxxxxxxxxxxx

# --- App ---
# URL base usada para construir los redirect de Stripe Checkout/Portal
NEXT_PUBLIC_APP_URL=http://localhost:3000
